{
  "name": "personal-brand-os",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "content:check": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/check-content.mts",
    "build": "pnpm content:check && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run lint && pnpm run typecheck",
    "docs:check": "echo \"Documentation foundation ready\"",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.86.0",
    "@payloadcms/next": "^3.86.0",
    "@payloadcms/richtext-lexical": "^3.86.0",
    "geist": "^1.3.1",
    "graphql": "^16.14.2",
    "gray-matter": "^4.0.3",
    "next": "^15.5.0",
    "next-mdx-remote": "^6.0.0",
    "payload": "^3.86.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "overrides": {}
  },
  "type": "module"
}
