# Mẫu biến môi trường. KHÔNG điền giá trị thật vào file này.
# Giá trị thật đặt ở .env.local trên máy, và ở Environment Variables trên Vercel.

# --- Bắt buộc ---

# Supabase: dùng chuỗi SESSION POOLER (nút Connect trong dashboard).
# KHÔNG dùng Direct connection — nó chỉ phân giải ra IPv6, Vercel không gọi được,
# và lỗi đó chỉ lộ ra ở production chứ không lộ khi chạy máy cá nhân.
DATABASE_URI=

# Khoá ký phiên đăng nhập trang quản trị. Sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Tuỳ chọn: thiếu thì code vẫn chạy, chỉ tắt tính năng tương ứng ---

# Kho ảnh và file tải về. BẮT BUỘC trên Vercel vì hệ thống file ở đó chỉ đọc.
# Lấy bằng cách tạo một Blob store trong mục Storage của dự án Vercel.
# Để trống khi chạy máy cá nhân thì Payload lưu vào đĩa.
BLOB_READ_WRITE_TOKEN=

# Gửi email: khôi phục mật khẩu quản trị và thông báo khi có người liên hệ.
# Để trống thì Payload in email ra màn hình thay vì gửi thật.
RESEND_API_KEY=

# Google Analytics 4
NEXT_PUBLIC_GA_ID=
