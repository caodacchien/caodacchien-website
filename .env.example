# Mẫu biến môi trường. Không điền giá trị thật vào file này.
# Giá trị thật chỉ đặt ở .env.local trên máy cá nhân và ở Vercel Environment Variables.
# Biến không có tiền tố NEXT_PUBLIC_ chỉ được dùng phía server.

# Application — Milestone 1.1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=vi

# Supabase — Milestone 1.3
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ dùng phía server. Không bao giờ để lọt vào bundle client.
SUPABASE_SERVICE_ROLE_KEY=

# Contact form và email — Milestone 1.7 (Resend, xem D8)
# Chưa tạo API key ở Phase 0.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Salt dùng để băm IP phục vụ rate limit. Không lưu IP thô.
CONTACT_IP_HASH_SALT=

# Analytics — Milestone 1.8
# MVP chỉ dùng Google Analytics 4 (xem D9).
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity — Phase 2, chưa bật ở MVP
# NEXT_PUBLIC_CLARITY_ID=
